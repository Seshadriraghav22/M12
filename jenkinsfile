pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'war', url: 'https://github.com/Seshadriraghav22/M12.git'
            }
        }
        stage('Build Project') {
            steps {
                sh 'mvn clean'
                sh 'mvn install'
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    // Build the Docker image
                    app = docker.build("seshadriraghav22/may19")
                    // Run a test command inside the Docker container
                    app.inside {
                        sh 'curl -f http://localhost:8080 || echo "Service not available"'
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {        
                    docker.withRegistry('https://registry.hub.docker.com', 'dochub') {
                        app.push("${env.BUILD_NUMBER}")
                        app.push("latest")
                    }
                }
            }
        }
        stage('Deploy to Server') {
            steps {
                input 'Deploy to Production?' // Prompt for user input
                milestone(1) // Mark this stage as a milestone to prevent skipping it

                withCredentials([usernamePassword(credentialsId: 'prod', usernameVariable: 'USERNAME', passwordVariable: 'USERPASS')]) {
                    script {
                        try {
                            // Pull the Docker image in the production server
                            sh """
                                sshpass -p '$USERPASS' -v ssh -o StrictHostKeyChecking=no $USERNAME@$prod_ip \
                                "docker pull seshadriraghav22/may19:${env.BUILD_NUMBER}"
                            """
                        } catch (Exception e) {
                            echo "Deployment failed: ${e.getMessage()}"
                            currentBuild.result = 'FAILURE' // Mark the build as failed if the deployment fails
                        }
                    }
                }
            }
        }
    }
}
